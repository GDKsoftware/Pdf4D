// Port of: pdfbox/src/main/java/org/apache/pdfbox/text/PDFTextStripper.java and TextPosition.java (3.0.8), tables as data
unit Pdf4D.Resources.Unicode;

interface

uses
  System.SysUtils;

type
  // The Unicode tables of the text extraction, generated by tools/unicode/generate-text-tables.ps1 with the JDK of the oracle.
  TPdfUnicodeResources = class
  public
    class function TextTables: TBytes; static;
  end;

implementation

{$R 'Pdf4D.Resources.Unicode.res'}

uses
  Pdf4D.Common.ResourceData;

{ TPdfUnicodeResources }

class function TPdfUnicodeResources.TextTables: TBytes;
begin
  Result := TPdfResourceData.Load(TPdfResourceData.NameOf('UNICODE', 'TextTables'));
end;

end.
