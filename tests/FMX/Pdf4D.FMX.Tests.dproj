        <DCC_UnitSearchPath>..\..\src\Common;..\..\src\IO;..\..\src\Cos;..\..\src\Parser;..\..\src\Content;..\..\src\Filter;..\..\src\Crypto;..\..\src\Encryption;..\..\src\Model;..\..\src\Api;..\..\src\Resources;..\..\src\Text;..\..\src\FontBox;..\..\src\Font;..\..\src\Render;..\..\src\Render\Skia;..\..\src\Viewer;..\..\src\FMX;..\..\src\FMX\Skia;..\..\src\Graphics;..\..\src\Codec;..\Support;Support;..\ThirdParty\DEC\Source;$(BDS)\source\DUnitX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
