{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Pdf4D core: native PDF reader'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

