package Pdf4D.Render;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Pdf4D rendering: device contract, bitmap and renderer'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  Pdf4D;

contains
  Pdf4D.Graphics.&Function in '..\src\Graphics\Pdf4D.Graphics.Function.pas',
  Pdf4D.Graphics.&Function.PostScript in '..\src\Graphics\Pdf4D.Graphics.Function.PostScript.pas',
  Pdf4D.Graphics.Icc.Profile in '..\src\Graphics\Pdf4D.Graphics.Icc.Profile.pas',
  Pdf4D.Graphics.Icc.Transform in '..\src\Graphics\Pdf4D.Graphics.Icc.Transform.pas',
  Pdf4D.Graphics.Color in '..\src\Graphics\Pdf4D.Graphics.Color.pas',
  Pdf4D.Graphics.Color.Device in '..\src\Graphics\Pdf4D.Graphics.Color.Device.pas',
  Pdf4D.Graphics.Color.IccBased in '..\src\Graphics\Pdf4D.Graphics.Color.IccBased.pas',
  Pdf4D.Graphics.Color.Factory in '..\src\Graphics\Pdf4D.Graphics.Color.Factory.pas',
  Pdf4D.Graphics.LineDash in '..\src\Graphics\Pdf4D.Graphics.LineDash.pas',
  Pdf4D.Graphics.State in '..\src\Graphics\Pdf4D.Graphics.State.pas',
  Pdf4D.Resources.Icc in '..\src\Resources\Pdf4D.Resources.Icc.pas',
  Pdf4D.Render.Bitmap in '..\src\Render\Pdf4D.Render.Bitmap.pas',
  Pdf4D.Render.CancelToken in '..\src\Render\Pdf4D.Render.CancelToken.pas',
  Pdf4D.Render.ClipPath in '..\src\Render\Pdf4D.Render.ClipPath.pas',
  Pdf4D.Render.Device.Interfaces in '..\src\Render\Pdf4D.Render.Device.Interfaces.pas',
  Pdf4D.Render.GraphicsEngine in '..\src\Render\Pdf4D.Render.GraphicsEngine.pas',
  Pdf4D.Render.Operators.Color in '..\src\Render\Pdf4D.Render.Operators.Color.pas',
  Pdf4D.Render.Operators.Path in '..\src\Render\Pdf4D.Render.Operators.Path.pas',
  Pdf4D.Render.Operators.State in '..\src\Render\Pdf4D.Render.Operators.State.pas',
  Pdf4D.Render.Options in '..\src\Render\Pdf4D.Render.Options.pas',
  Pdf4D.Render.PageDrawer in '..\src\Render\Pdf4D.Render.PageDrawer.pas',
  Pdf4D.Render.PageTransform in '..\src\Render\Pdf4D.Render.PageTransform.pas',
  Pdf4D.Render.Renderer in '..\src\Render\Pdf4D.Render.Renderer.pas',
  Pdf4D.Render.Renderer.Interfaces in '..\src\Render\Pdf4D.Render.Renderer.Interfaces.pas';

end.
