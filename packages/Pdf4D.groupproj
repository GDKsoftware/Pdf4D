<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{5A8E2C4D-91B3-4F67-8D20-C7E1A4B93F58}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Pdf4D.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Pdf4D.Render.dproj">
            <Dependencies>Pdf4D.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Pdf4D">
        <MSBuild Projects="Pdf4D.dproj"/>
    </Target>
    <Target Name="Pdf4D:Clean">
        <MSBuild Projects="Pdf4D.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Pdf4D:Make">
        <MSBuild Projects="Pdf4D.dproj" Targets="Make"/>
    </Target>
    <Target Name="Pdf4D.Render" DependsOnTargets="Pdf4D">
        <MSBuild Projects="Pdf4D.Render.dproj"/>
    </Target>
    <Target Name="Pdf4D.Render:Clean" DependsOnTargets="Pdf4D:Clean">
        <MSBuild Projects="Pdf4D.Render.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Pdf4D.Render:Make" DependsOnTargets="Pdf4D:Make">
        <MSBuild Projects="Pdf4D.Render.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Pdf4D;Pdf4D.Render"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Pdf4D:Clean;Pdf4D.Render:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Pdf4D:Make;Pdf4D.Render:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
